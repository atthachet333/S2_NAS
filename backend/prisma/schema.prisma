generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// การจำแนกชนิดของบัญชี - เป็นตัวกำหนดนโยบายพื้นฐาน ไม่ใช่บทบาท
/// INTERNAL = บุคลากรขององค์กร ใช้พื้นที่ทำงานภายในตามบทบาทและสิทธิ์ปกติ
/// EXTERNAL = ลูกค้า/ผู้ใช้งานภายนอก เห็นได้เฉพาะสิ่งที่ถูกแชร์ให้โดยตรงผ่าน /portal เท่านั้น
/// SERVICE  = บัญชีตัวแทนของระบบเชื่อมต่อ ไม่ใช่มนุษย์
///
/// ชนิดของบัญชีมีน้ำหนักเหนือบทบาทเสมอ บัญชี EXTERNAL ที่เผลอได้บทบาทภายในกว้าง ๆ
/// ก็ยังถูกจำกัดด้วยนโยบายภายนอกอยู่ดี (ดู modules/portal/portal-policy.ts)
enum UserType {
  INTERNAL
  EXTERNAL
  SERVICE
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ResourceType {
  FILE
  FOLDER
  GOOGLE_SHEET
  GOOGLE_DOC
  GOOGLE_DRIVE
  WEB_LINK
  SYSTEM_FILE
  SHORTCUT
}

enum ResourceSourceType {
  MANUAL
  GOOGLE
  S2_PAYROLL
  S2_ERP
  S2_LINE_BOT
  EXTERNAL_UPLOAD
  SYSTEM
}

/// ระดับการมองเห็นของโฟลเดอร์/ทรัพยากรในระดับองค์กร
/// ORGANIZATION = ผู้ใช้ ACTIVE ในองค์กรเปิดดูได้ (ค่าเริ่มต้นของโฟลเดอร์ทั่วไป)
/// RESTRICTED   = เฉพาะผู้ดูแล ผู้ได้รับสิทธิ์โดยตรง และผู้ดูแลระบบ
enum ResourceVisibility {
  ORGANIZATION
  RESTRICTED
}

/// ไดร์ฟระดับบนสุดที่ทรัพยากรสังกัด
/// MY_DRIVE     = พื้นที่ทำงานที่ผู้ใช้รับผิดชอบตามนโยบายการเข้าถึง (ข้อมูลยังเป็นของบริษัท)
/// SYSTEM_DRIVE = ไดร์ฟกลางขององค์กรหนึ่งเดียว เช่น คู่มือบริษัท แบบฟอร์มกลาง Templates
/// ทรัพยากรลูกสืบทอดค่านี้จากโฟลเดอร์แม่เสมอ จึงตัดสินได้จากแถวเดียวโดยไม่ต้องไล่ลำดับชั้น
enum DriveScope {
  MY_DRIVE
  SYSTEM_DRIVE
}

enum ResourceAccessLevel {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique @db.VarChar(191)
  displayName         String                   @db.VarChar(191)
  passwordHash        String?                  @db.VarChar(191)
  type                UserType                 @default(INTERNAL)
  status              UserStatus               @default(INVITED)
  mustChangePassword  Boolean                  @default(true)
  tokenVersion        Int                      @default(0)
  lastLoginAt         DateTime?
  /// ชื่อบริษัท/หน่วยงานของผู้ใช้ภายนอก - ใช้แยกแยะลูกค้าในหน้าจัดการเท่านั้น
  /// ไม่ใช่ขอบเขตสิทธิ์ สิทธิ์มาจากการแชร์รายทรัพยากรเสมอ
  organizationName    String?                  @db.VarChar(191)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  roles               UserRole[]
  refreshTokens       RefreshToken[]
  activityLogs        ActivityLog[]
  ownedResources      Resource[]               @relation("ResourceOwner")
  createdResources    Resource[]               @relation("ResourceCreator")
  updatedResources    Resource[]               @relation("ResourceUpdater")
  deletedResources    Resource[]               @relation("ResourceDeleter")
  lockedResources     Resource[]               @relation("ResourceLocker")
  favorites           UserFavorite[]           @relation("UserFavorites")
  pins                UserPinnedResource[]     @relation("UserPins")
  createdTags         Tag[]                    @relation("TagCreator")
  taggedResources     ResourceTag[]            @relation("ResourceTagCreator")
  createdVersions     ResourceVersion[]        @relation("ResourceVersionCreator")
  resourceAccess      ResourceAccess[]         @relation("ResourceAccessUser")
  grantedAccess       ResourceAccess[]         @relation("ResourceAccessCreator")
  integrationApp      IntegrationApp?          @relation("IntegrationActor")
  triggeredBackups    BackupLog[]              @relation("BackupTrigger")
  triggeredRehearsals RestoreRehearsalLog[]    @relation("RehearsalTrigger")
  identities          UserIdentity[]           @relation("UserIdentities")
  savedSearches       SavedSearch[]            @relation("SavedSearchOwner")
  documentCategories  DocumentCategory[]       @relation("DocumentCategoryCreator")
  reviewedIndexes     ResourceSearchIndex[]    @relation("OcrReviewer")
  textCorrections     ResourceTextCorrection[] @relation("TextCorrectionAuthor")
  correctedIndexes    ResourceSearchIndex[]    @relation("TextCorrector")

  @@index([status])
  @@index([createdAt])
  @@index([type, status])
  @@map("users")
}

model Resource {
  id                        String                   @id @default(cuid())
  type                      ResourceType
  name                      String                   @db.VarChar(191)
  normalizedName            String                   @db.VarChar(191)
  siblingKey                String                   @unique @db.VarChar(500)
  parentId                  String?
  ownerId                   String
  createdById               String
  updatedById               String?
  sourceType                ResourceSourceType       @default(MANUAL)
  mimeType                  String?                  @db.VarChar(191)
  extension                 String?                  @db.VarChar(32)
  size                      BigInt?
  storageKey                String?                  @unique @db.VarChar(500)
  checksum                  String?                  @db.VarChar(191)
  externalUrl               String?                  @db.Text
  externalProvider          String?                  @db.VarChar(100)
  sourceSystem              String?                  @db.VarChar(100)
  sourceEntityType          String?                  @db.VarChar(100)
  sourceEntityId            String?                  @db.VarChar(191)
  sourceUrl                 String?                  @db.Text
  createdByIntegrationAppId String?
  remark                    String?                  @db.VarChar(1000)
  /// ประเภทเอกสารที่คนกำหนดไว้ - null คือยังไม่ได้จัดประเภท ไม่ใช่ "ไม่มีประเภท"
  documentCategoryId        String?
  isLocked                  Boolean                  @default(false)
  /// ใครล็อก เมื่อไร และเพราะอะไร - สำคัญมากกับเอกสารบัญชีที่ปิดงบแล้ว
  lockedAt                  DateTime?
  lockedById                String?
  lockReason                String?                  @db.VarChar(500)
  /// นโยบายการมองเห็น สืบทอดจากโฟลเดอร์แม่เมื่อสร้างทรัพยากรใหม่
  visibility                ResourceVisibility       @default(ORGANIZATION)
  /// ไดร์ฟที่สังกัด สืบทอดจากโฟลเดอร์แม่เมื่อสร้าง/ย้ายทรัพยากร
  driveScope                DriveScope               @default(MY_DRIVE)
  /// เลขเวอร์ชันปัจจุบันของไฟล์ (สะท้อนจาก ResourceVersion เพื่อให้ listing เร็ว)
  currentVersion            Int?
  deletedAt                 DateTime?
  /// ผู้ที่ย้ายทรัพยากรไปถังขยะ และตำแหน่งเดิมก่อนถูกลบ ใช้สำหรับการกู้คืน
  deletedById               String?
  trashedFromId             String?                  @db.VarChar(191)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  parent                    Resource?                @relation("ResourceHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                  Resource[]               @relation("ResourceHierarchy")
  owner                     User                     @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy                 User                     @relation("ResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                 User?                    @relation("ResourceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy                 User?                    @relation("ResourceDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  lockedBy                  User?                    @relation("ResourceLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  documentCategory          DocumentCategory?        @relation(fields: [documentCategoryId], references: [id], onDelete: SetNull)
  access                    ResourceAccess[]
  versions                  ResourceVersion[]
  tags                      ResourceTag[]
  favoritedBy               UserFavorite[]
  pinnedBy                  UserPinnedResource[]
  searchIndex               ResourceSearchIndex[]
  createdByIntegrationApp   IntegrationApp?          @relation("IntegrationResourceCreator", fields: [createdByIntegrationAppId], references: [id], onDelete: SetNull)
  integrationScopeApps      IntegrationApp[]         @relation("IntegrationAllowedRoot")
  integrationIdempotency    IntegrationIdempotency[]

  @@index([parentId])
  @@index([ownerId])
  @@index([type])
  @@index([sourceType])
  @@index([deletedAt])
  @@index([updatedAt])
  @@index([parentId, type, deletedAt])
  @@index([checksum])
  @@index([visibility])
  @@index([driveScope])
  @@index([driveScope, parentId, deletedAt])
  @@index([normalizedName])
  @@index([isLocked])
  @@index([createdByIntegrationAppId])
  @@index([sourceSystem, sourceEntityType, sourceEntityId])
  @@map("resources")
}

/// ประวัติเวอร์ชันของไฟล์ - เป็นหลักฐานที่แก้ไขไม่ได้
/// Resource เก็บ metadata ล่าสุดไว้เพื่อความเร็ว แต่ความจริงทางประวัติศาสตร์อยู่ที่นี่
model ResourceVersion {
  id                        String   @id @default(cuid())
  resourceId                String
  versionNumber             Int
  storageKey                String   @unique @db.VarChar(500)
  size                      BigInt
  checksum                  String   @db.VarChar(191)
  mimeType                  String?  @db.VarChar(191)
  remark                    String?  @db.VarChar(1000)
  createdById               String
  createdAt                 DateTime @default(now())
  createdByIntegrationAppId String?

  resource                Resource             @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdBy               User                 @relation("ResourceVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdByIntegrationApp IntegrationApp?      @relation("IntegrationVersionCreator", fields: [createdByIntegrationAppId], references: [id], onDelete: SetNull)
  searchIndex             ResourceSearchIndex?

  @@unique([resourceId, versionNumber])
  @@index([resourceId])
  @@index([checksum])
  @@index([createdById])
  @@index([createdByIntegrationAppId])
  @@map("resource_versions")
}

/// รายการโปรดส่วนบุคคล - เป็นความชอบของผู้ใช้ ไม่ใช่การให้สิทธิ์
model UserFavorite {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  createdAt  DateTime @default(now())

  user     User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
  @@map("user_favorites")
}

/// การปักหมุดเพื่อให้เข้าถึงเร็วจากหน้าไฟล์ แยกความหมายจากรายการโปรด
model UserPinnedResource {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  user     User     @relation("UserPins", fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, sortOrder])
  @@index([resourceId])
  @@map("user_pinned_resources")
}

/// แท็กระดับองค์กร ใช้ร่วมกันทั้งระบบ
/// normalizedName กันชื่อซ้ำแบบไม่สนตัวพิมพ์ใหญ่เล็กและช่องว่างส่วนเกิน
model Tag {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(64)
  normalizedName String   @unique @db.VarChar(64)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User          @relation("TagCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resources ResourceTag[]

  @@index([normalizedName])
  @@map("tags")
}

/// ความสัมพันธ์ระหว่างทรัพยากรกับแท็ก
model ResourceTag {
  resourceId  String
  tagId       String
  createdById String
  createdAt   DateTime @default(now())

  resource  Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ResourceTagCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([resourceId, tagId])
  @@index([tagId])
  @@index([resourceId])
  @@map("resource_tags")
}

/// การมอบสิทธิ์รายบุคคลบนทรัพยากรหนึ่งชิ้น
///
/// expiresAt ทำให้สิทธิ์ของลูกค้าหมดอายุเองโดยไม่ต้องรอใครมาเก็บกวาด
/// การตรวจสิทธิ์ทุกครั้งเทียบกับเวลาปัจจุบันเสมอ แถวที่หมดอายุจึงถูกปฏิเสธทันที
/// แต่ยังคงอยู่ในฐานข้อมูลเพื่อการตรวจสอบย้อนหลัง
model ResourceAccess {
  id            String              @id @default(cuid())
  resourceId    String
  userId        String
  accessLevel   ResourceAccessLevel
  allowDownload Boolean             @default(false)
  /// null = ไม่หมดอายุ มิฉะนั้นคือเวลาสิ้นสุดสิทธิ์แบบสัมบูรณ์ (UTC)
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  resource      Resource            @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user          User                @relation("ResourceAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("ResourceAccessCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([resourceId, userId])
  @@index([resourceId])
  @@index([userId])
  @@index([userId, expiresAt])
  @@map("resource_access")
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(191)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(191)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model ActivityLog {
  id               String          @id @default(cuid())
  userId           String?
  action           String          @db.VarChar(100)
  resourceId       String?         @db.VarChar(191)
  ipAddress        String?         @db.VarChar(64)
  userAgent        String?         @db.VarChar(500)
  metadata         Json?
  createdAt        DateTime        @default(now())
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  integrationAppId String?
  integrationApp   IntegrationApp? @relation(fields: [integrationAppId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([resourceId, createdAt])
  @@index([action, createdAt])
  @@index([integrationAppId, createdAt])
  @@map("activity_logs")
}

model IntegrationApp {
  id            String                   @id @default(cuid())
  name          String                   @db.VarChar(191)
  code          String                   @unique @db.VarChar(64)
  description   String?                  @db.VarChar(500)
  isActive      Boolean                  @default(true)
  actorUserId   String                   @unique
  allowedRootId String
  scopes        Json
  lastUsedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  actorUser     User                     @relation("IntegrationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  allowedRoot   Resource                 @relation("IntegrationAllowedRoot", fields: [allowedRootId], references: [id], onDelete: Restrict)
  credentials   IntegrationCredential[]
  resources     Resource[]               @relation("IntegrationResourceCreator")
  versions      ResourceVersion[]        @relation("IntegrationVersionCreator")
  activityLogs  ActivityLog[]
  idempotency   IntegrationIdempotency[]

  @@index([allowedRootId])
  @@index([isActive])
  @@map("integration_apps")
}

model IntegrationCredential {
  id         String         @id @default(cuid())
  appId      String
  secretHash String         @db.Char(64)
  label      String?        @db.VarChar(191)
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime       @default(now())
  app        IntegrationApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, revokedAt])
  @@map("integration_credentials")
}

model IntegrationIdempotency {
  id          String         @id @default(cuid())
  appId       String
  key         String         @db.VarChar(191)
  requestHash String         @db.Char(64)
  resourceId  String
  createdAt   DateTime       @default(now())
  app         IntegrationApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  resource    Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([appId, key])
  @@index([resourceId])
  @@map("integration_idempotency")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(191)
  value       String   @db.Text
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum BackupType {
  FULL
}

/// ใครสั่งให้สำรอง - ผู้ดูแลกดเอง หรือตารางเวลาของระบบ
/// จำเป็นต่อการกันไม่ให้รันซ้ำหลังเซิร์ฟเวอร์รีสตาร์ท
enum BackupTrigger {
  MANUAL
  SCHEDULED
}

/// สถานะการคัดลอกออกไปเก็บนอกเครื่อง - แยกจาก BackupStatus โดยตั้งใจ
/// ชุดสำรองในเครื่องที่ตรวจผ่านแล้วยังถือว่าใช้ได้ แม้การคัดลอกออกนอกเครื่องจะล้มเหลว
enum OffsiteState {
  NOT_CONFIGURED
  PENDING
  COPYING
  VERIFIED
  FAILED
}

/// บันทึกการสำรองข้อมูลหนึ่งครั้ง = ภาพนิ่งหนึ่งชุดที่สอดคล้องกันของ S2 NAS
/// ห้ามส่ง backupName หรือ path จริงออกไปใน DTO - เป็นข้อมูลของเครื่อง ไม่ใช่ของผู้ใช้
model BackupLog {
  id                String        @id @default(cuid())
  status            BackupStatus  @default(PENDING)
  type              BackupType    @default(FULL)
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  triggeredByUserId String?
  databaseBytes     BigInt?
  storageBytes      BigInt?
  totalBytes        BigInt?
  fileCount         Int?
  /// ชื่อโฟลเดอร์ของชุดสำรองภายใต้ S2_NAS_BACKUP_ROOT (ไม่ใช่ absolute path)
  backupName        String        @unique @db.VarChar(191)
  errorCode         String?       @db.VarChar(100)
  /// ข้อความที่ปลอดภัยพอจะแสดงให้ผู้ดูแลเห็น ห้ามมี command line, path จริง หรือรหัสผ่าน
  errorMessageSafe  String?       @db.VarChar(500)
  manifestChecksum  String?       @db.VarChar(191)
  /// ผู้สั่ง - ตารางเวลาหรือผู้ดูแล
  trigger           BackupTrigger @default(MANUAL)
  /// สถานะสำเนานอกเครื่องของชุดสำรองนี้
  offsiteState      OffsiteState  @default(NOT_CONFIGURED)
  offsiteVerifiedAt DateTime?
  offsiteAttempts   Int           @default(0)
  /// เหตุผลที่คัดลอกออกนอกเครื่องไม่สำเร็จ - ต้องไม่มี path จริงหรือความลับ
  offsiteErrorSafe  String?       @db.VarChar(500)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  triggeredBy User? @relation("BackupTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startedAt])
  @@index([trigger, status, startedAt])
  @@index([offsiteState])
  @@map("backup_logs")
}

/// ผลของการซ้อมกู้คืน - ชุดสำรองที่ยังไม่เคยกู้คืนสำเร็จ ยังพิสูจน์ไม่ได้ว่าใช้ได้จริง
enum RehearsalStatus {
  RUNNING
  PASSED
  FAILED
}

enum RehearsalTrigger {
  MANUAL
  SCHEDULED
}

/// บันทึกการซ้อมกู้คืนหนึ่งครั้ง
/// ซ้อมในพื้นที่พักเสมอ ไม่มีขั้นตอนใดแตะระบบที่ใช้งานจริง
model RestoreRehearsalLog {
  id                String           @id @default(cuid())
  backupId          String           @db.VarChar(191)
  status            RehearsalStatus  @default(RUNNING)
  trigger           RehearsalTrigger @default(MANUAL)
  startedAt         DateTime         @default(now())
  completedAt       DateTime?
  databaseRestored  Boolean          @default(false)
  storageRestored   Boolean          @default(false)
  resourceCount     Int?
  versionCount      Int?
  missingCount      Int?
  orphanCount       Int?
  checksumFailures  Int?
  /// การล้างพื้นที่พักล้มเหลวต้องเห็นแยกจากผลการซ้อม
  cleanupFailed     Boolean          @default(false)
  errorCode         String?          @db.VarChar(100)
  /// ข้อความที่ปลอดภัยพอจะแสดงให้ผู้ดูแล ห้ามมี path จริง คำสั่ง หรือรหัสผ่าน
  errorMessageSafe  String?          @db.VarChar(500)
  triggeredByUserId String?
  createdAt         DateTime         @default(now())

  triggeredBy User? @relation("RehearsalTrigger", fields: [triggeredByUserId], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([backupId])
  @@map("restore_rehearsal_logs")
}

/// ชนิดของงานในคิวเดียวกัน
/// EXTRACT = สกัดข้อความที่ฝังอยู่ในไฟล์อยู่แล้ว ราคาถูก ทำอัตโนมัติหลังอัปโหลด
/// OCR     = อ่านข้อความจากภาพ ราคาแพง ทำเมื่อมีคนสั่งเท่านั้น
///
/// อยู่ในคิวเดียวกันโดยตั้งใจ เพื่อให้การกู้คืนหลังเซิร์ฟเวอร์ล่ม การจองงาน
/// และการลองใหม่ ใช้กลไกชุดเดียว แต่แยกลำดับความสำคัญและจำนวนงานพร้อมกัน
enum SearchJobKind {
  EXTRACT
  OCR
}

/// ที่มาของข้อความที่ค้นหาได้
/// NATIVE_TEXT = สกัดจากข้อความที่ฝังอยู่ในไฟล์จริง เชื่อถือได้
/// OCR         = อ่านจากภาพ เป็นการคาดเดาของเครื่อง อาจไม่ถูกต้องทั้งหมด
/// HUMAN_CORRECTED = คนตรวจแก้ผลของ OCR แล้ว เชื่อถือได้กว่าผลดิบ
///
/// ต้องแยกให้ชัด เพราะข้อความจาก OCR มีโอกาสผิด และผู้ใช้ควรรู้ว่ากำลังเชื่ออะไรอยู่
enum SearchTextSource {
  NATIVE_TEXT
  OCR
  HUMAN_CORRECTED
}

/// สถานะการสกัดข้อความของไฟล์หนึ่งเวอร์ชัน
///
/// ทุกสถานะมีความหมายชัดเจน ไม่มีการใช้ null แทน "ไม่รู้"
/// PENDING     = รอคิว
/// PROCESSING  = กำลังทำ (มี processingStartedAt กำกับ ใช้กู้คืนหลังเซิร์ฟเวอร์ล่ม)
/// READY       = สกัดสำเร็จ มีข้อความค้นได้
/// NO_TEXT     = ไฟล์ถูกต้องแต่ไม่มีข้อความให้สกัด เช่น PDF ที่เป็นภาพสแกน (ยังไม่มี OCR)
/// UNSUPPORTED = ชนิดไฟล์ที่ระบบยังไม่สกัด เช่น รูปภาพ วิดีโอ ไฟล์บีบอัด
/// FAILED      = พยายามแล้วไม่สำเร็จ เช่น ไฟล์เสียหายหรือมีรหัสผ่าน
/// สถานะ "การตรวจโดยมนุษย์" ของผลที่เครื่องอ่านมา
///
/// แยกจาก SearchIndexStatus โดยตั้งใจ เพราะเป็นคนละคำถามกัน
///   SearchIndexStatus ตอบว่า "เครื่องอ่านสำเร็จหรือไม่"
///   OcrReviewStatus   ตอบว่า "มีคนดูผลนั้นแล้วหรือยัง"
/// การยัดสองเรื่องนี้ลง enum เดียวจะทำให้ตอบไม่ได้ว่างานที่ FAILED เคยมีคนดูแล้วหรือยัง
///
/// UNREVIEWED = ยังไม่มีใครตรวจ
/// VERIFIED   = คนอ่านแล้วยืนยันว่าเครื่องอ่านถูก โดยไม่ต้องแก้อะไร
/// CORRECTED  = คนแก้ข้อความแล้ว (คู่กับ textSource = HUMAN_CORRECTED)
enum OcrReviewStatus {
  UNREVIEWED
  VERIFIED
  CORRECTED
}

enum SearchIndexStatus {
  PENDING
  PROCESSING
  READY
  NO_TEXT
  UNSUPPORTED
  FAILED
}

/// ข้อความที่สกัดจากไฟล์หนึ่งเวอร์ชัน เพื่อให้ค้นหาจาก "เนื้อในเอกสาร" ได้
///
/// หนึ่งแถวต่อหนึ่งเวอร์ชัน - งานสกัดจึงทำซ้ำได้โดยไม่เกิดผลข้างเคียง (idempotent)
/// และประวัติของเวอร์ชันเก่ายังอยู่ครบ
///
/// การค้นหาปกติเทียบ versionNumber กับ Resource.currentVersion เสมอ
/// เนื้อหาของเวอร์ชันเก่าจึงไม่มีทางถูกคืนเป็นผลลัพธ์ปัจจุบัน
///
/// ข้อความที่สกัดได้เป็นข้อมูลลับเท่ากับตัวเอกสารต้นทาง
/// ห้ามบันทึกลง log ห้ามส่งออกนอกระบบ และห้ามคืนให้ผู้ที่ไม่มีสิทธิ์เห็นเอกสารนั้น
model ResourceSearchIndex {
  id                  String            @id @default(cuid())
  resourceId          String
  resourceVersionId   String            @unique
  /// เลขเวอร์ชันของไฟล์ ใช้เทียบกับ Resource.currentVersion เพื่อหาเวอร์ชันที่มีผลอยู่
  versionNumber       Int
  status              SearchIndexStatus @default(PENDING)
  /// งานชิ้นนี้เป็นการสกัดข้อความปกติ หรือการอ่านภาพด้วย OCR
  jobKind             SearchJobKind     @default(EXTRACT)
  /// ข้อความที่ค้นหาได้มาจากไหน - null เมื่อยังไม่มีข้อความ
  textSource          SearchTextSource?
  mimeType            String?           @db.VarChar(191)
  /// ข้อความตามที่สกัดได้จริง ใช้ตัดข้อความรอบคำค้นมาแสดง
  extractedText       String?           @db.MediumText
  /// ข้อความที่ปรับให้เทียบง่าย - NFC + ตัวพิมพ์เล็ก + ยุบช่องว่าง ใช้เป็นเป้าของการค้นหา
  normalizedText      String?           @db.MediumText
  characterCount      Int               @default(0)
  /// ข้อความยาวเกินเพดานจึงถูกตัด - ต้องบอกตามจริง ไม่ใช่ทำเหมือนสกัดครบ
  truncated           Boolean           @default(false)
  extractedAt         DateTime?
  /// รุ่นของตัวสกัด ใช้ตัดสินว่าควรสกัดใหม่เมื่อกติกาการสกัดเปลี่ยน
  extractorVersion    String            @db.VarChar(32)
  errorCode           String?           @db.VarChar(100)
  attempts            Int               @default(0)
  /// เวลาที่เริ่มทำงาน - งานที่ค้างอยู่นานเกินไปแปลว่าเซิร์ฟเวอร์ล่มกลางคัน
  processingStartedAt DateTime?

  /// เคยมีคนสั่ง OCR ไฟล์เวอร์ชันนี้แล้วหรือยัง - OCR ไม่เกิดขึ้นเองโดยอัตโนมัติ
  ocrRequested   Boolean   @default(false)
  /// ชื่อและรุ่นของเครื่องมือที่ใช้ เก็บไว้เพื่อให้ย้อนรอยได้ว่าผลนี้มาจากอะไร
  ocrEngine      String?   @db.VarChar(100)
  ocrLanguages   String?   @db.VarChar(64)
  /// ความมั่นใจเฉลี่ยของเครื่อง ใช้เป็นข้อมูลวินิจฉัยเท่านั้น
  /// ห้ามใช้ตัดสินสิทธิ์ และห้ามนำเสนอเป็นการรับประกันความถูกต้อง
  ocrConfidence  Float?
  ocrCompletedAt DateTime?
  /// จำนวนหน้าที่อ่านจริง - ต่างจากจำนวนหน้าทั้งหมดเมื่อชนเพดาน
  ocrPageCount   Int?

  // ---- การตรวจแก้โดยมนุษย์ ----

  /// ผลดิบของ OCR ก่อนถูกตรวจแก้ - เก็บไว้ถาวรเพื่อการตรวจสอบและเทียบเคียงในอนาคต
  /// การเขียนทับผลดิบทิ้งทำให้ตอบไม่ได้ว่าเครื่องอ่านผิดตรงไหน และวัดคุณภาพ OCR ไม่ได้อีกเลย
  rawOcrText         String?   @db.MediumText
  /// ผู้ที่ตรวจแก้ล่าสุด
  correctedById      String?
  correctedAt        DateTime?
  /// เลขรุ่นของการตรวจแก้ - ใช้กันการเขียนทับกันเองเมื่อมีสองคนแก้พร้อมกัน
  correctionRevision Int       @default(0)

  // ---- การตรวจผลของเครื่องโดยมนุษย์ (F15) ----

  /// มีคนตรวจผลนี้แล้วหรือยัง - ไม่ใช่เรื่องเดียวกับว่าเครื่องอ่านสำเร็จหรือไม่
  reviewStatus OcrReviewStatus @default(UNREVIEWED)
  /// ผู้ที่ตรวจล่าสุด - เป็นข้อมูลภายใน ไม่ส่งออกไปฝั่งลูกค้า
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  resource    Resource                 @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  version     ResourceVersion          @relation(fields: [resourceVersionId], references: [id], onDelete: Cascade)
  correctedBy User?                    @relation("TextCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  reviewedBy  User?                    @relation("OcrReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  corrections ResourceTextCorrection[]

  @@index([resourceId, versionNumber])
  @@index([status, createdAt])
  @@index([status, processingStartedAt])
  /// ใช้หยิบงานตามชนิด โดยให้การสกัดปกติมาก่อน OCR เสมอ
  @@index([status, jobKind, createdAt])
  /// ใช้โดยคิวตรวจ OCR - หางานที่ยังไม่มีใครตรวจ เรียงจากเก่าสุดก่อน
  @@index([reviewStatus, textSource, createdAt])
  @@map("resource_search_index")
}

/// ประวัติการตรวจแก้ข้อความหนึ่งครั้ง
///
/// เก็บทุกครั้งที่มีคนกดบันทึก ไม่ใช่ทุกครั้งที่พิมพ์ - ประวัติจึงมีความหมาย ไม่ใช่กองข้อมูลขยะ
///
/// ข้อความที่คนตรวจแก้แล้วไม่ใช่ "ข้อมูลที่สร้างใหม่ได้" ต่างจากผลของ OCR
/// มันคือแรงงานของมนุษย์ที่สร้างใหม่โดยอัตโนมัติไม่ได้ จึงต้องอยู่ในชุดสำรองเสมอ
/// และการกู้คืนต้องได้มันกลับมาครบ
model ResourceTextCorrection {
  id                    String   @id @default(cuid())
  resourceSearchIndexId String
  /// เลขรุ่น เริ่มที่ 1 และเพิ่มทีละหนึ่งต่อการบันทึกหนึ่งครั้ง
  revision              Int
  text                  String   @db.MediumText
  characterCount        Int      @default(0)
  createdById           String
  createdAt             DateTime @default(now())

  searchIndex ResourceSearchIndex @relation(fields: [resourceSearchIndexId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("TextCorrectionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  /// หนึ่งรุ่นต่อหนึ่งดัชนี - กันการบันทึกซ้ำจากการกดสองครั้ง
  @@unique([resourceSearchIndexId, revision])
  @@index([resourceSearchIndexId, revision])
  @@map("resource_text_corrections")
}

/// ประเภทของเอกสารตามการใช้งานจริงขององค์กร
///
/// ตั้งค่าได้ ไม่ใช่ enum ตายตัว - ประเภทเอกสารของแต่ละองค์กรต่างกัน
/// และการเพิ่มประเภทใหม่ไม่ควรต้องแก้โค้ดแล้ว deploy ใหม่
///
/// การจัดประเภทเป็นการตัดสินใจของคน ไม่ใช่การเดาของเครื่อง
model DocumentCategory {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  /// ใช้อ้างอิงใน URL และตัวกรอง - คงที่แม้ชื่อที่แสดงจะถูกเปลี่ยน
  slug        String   @unique @db.VarChar(100)
  /// ปิดการใช้งานแทนการลบ - ทรัพยากรที่เคยถูกจัดประเภทไว้ต้องไม่กำพร้า
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User       @relation("DocumentCategoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  resources Resource[]

  @@index([isActive, sortOrder])
  @@map("document_categories")
}

/// ชุดเงื่อนไขการค้นหาที่ผู้ใช้บันทึกไว้ใช้ซ้ำ
///
/// เป็นของส่วนตัวของแต่ละคน ไม่แชร์ข้ามผู้ใช้ใน F15
/// เพราะชื่อที่คนตั้งให้ชุดค้นหามักบอกใบ้เนื้องานที่เขากำลังทำอยู่
///
/// เก็บ "เงื่อนไข" ไม่ได้เก็บ "ผลลัพธ์" - ผลลัพธ์ถูกคำนวณใหม่ทุกครั้งพร้อมตรวจสิทธิ์
/// ชุดค้นหาที่บันทึกไว้จึงไม่มีทางกลายเป็นช่องทางเห็นเอกสารที่สิทธิ์ถูกถอนไปแล้ว
model SavedSearch {
  id         String    @id @default(cuid())
  userId     String
  name       String    @db.VarChar(100)
  /// คำค้น - แยกจากตัวกรองเพื่อให้แสดงและแก้ไขได้ตรงไปตรงมา
  query      String    @default("") @db.VarChar(191)
  /// ตัวกรองทั้งชุดในรูป JSON - ตรวจความถูกต้องด้วย schema เดียวกับ API ทุกครั้งที่อ่าน
  filters    Json
  /// ใช้จัดลำดับ "ที่ใช้บ่อย" โดยไม่ต้องนับสถิติการใช้งานแยกต่างหาก
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation("SavedSearchOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// ชื่อซ้ำในชุดของคนเดียวกันทำให้เลือกผิด จึงกันไว้ตั้งแต่ฐานข้อมูล
  @@unique([userId, name])
  @@index([userId, lastUsedAt])
  @@map("saved_searches")
}

/// ผู้ให้บริการยืนยันตัวตนภายนอก - F9 รองรับเฉพาะ Google
enum IdentityProvider {
  GOOGLE
}

/// การเชื่อมบัญชีภายนอกเข้ากับผู้ใช้ S2 NAS ที่มีอยู่แล้ว
///
/// providerSubject (sub ของ Google) คือกุญแจตัวจริงของตัวตน ไม่ใช่อีเมล
/// เพราะผู้ใช้เปลี่ยนอีเมลของบัญชี Google ได้ แต่ sub ไม่เปลี่ยน
/// การยึดอีเมลเป็นกุญแจจะทำให้ตัวตนย้ายไปหาผู้ใช้คนอื่นได้เมื่ออีเมลถูกเปลี่ยนมือ
model UserIdentity {
  id                      String           @id @default(cuid())
  userId                  String
  provider                IdentityProvider
  providerSubject         String           @db.VarChar(191)
  providerEmail           String?          @db.VarChar(191)
  providerEmailNormalized String?          @db.VarChar(191)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  lastLoginAt             DateTime?

  user User @relation("UserIdentities", fields: [userId], references: [id], onDelete: Cascade)

  /// ตัวตนภายนอกหนึ่งอันผูกกับผู้ใช้ได้คนเดียวเท่านั้น
  @@unique([provider, providerSubject])
  /// หนึ่งผู้ใช้เชื่อมบัญชี Google ได้บัญชีเดียว - กันความกำกวมตอนกู้คืนการเข้าถึง
  @@unique([provider, userId])
  @@index([providerEmailNormalized])
  @@map("user_identities")
}
