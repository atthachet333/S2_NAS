{
  "name": "s2-nas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "S2 NAS Backend API",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:smoke": "node scripts/migration-smoke-check.mjs",
    "prisma:seed": "tsx prisma/seed.ts",
    "rbac:sync": "tsx prisma/rbac-sync.ts",
    "backup:create": "tsx scripts/backup-cli.ts create",
    "backup:list": "tsx scripts/backup-cli.ts list",
    "backup:verify": "tsx scripts/backup-cli.ts verify",
    "backup:stage-restore": "tsx scripts/backup-cli.ts stage-restore",
    "backup:discard-stage": "tsx scripts/backup-cli.ts discard-stage",
    "backup:schedule-status": "tsx scripts/backup-cli.ts schedule-status",
    "backup:retention": "tsx scripts/backup-cli.ts retention",
    "backup:offsite": "tsx scripts/backup-cli.ts offsite",
    "backup:lock-status": "tsx scripts/backup-cli.ts lock-status",
    "restore:rehearsal": "tsx scripts/backup-cli.ts rehearsal",
    "restore:rehearsal-status": "tsx scripts/backup-cli.ts rehearsal-status",
    "qa:portal": "tsx scripts/f11-qa-fixture.ts create",
    "qa:portal-clean": "tsx scripts/f11-qa-fixture.ts destroy",
    "ocr:status": "tsx scripts/ocr-cli.ts status",
    "ocr:run": "tsx scripts/ocr-cli.ts run",
    "ocr:retry-failed": "tsx scripts/ocr-cli.ts retry-failed",
    "ocr:eligible": "tsx scripts/ocr-cli.ts eligible",
    "semantic:model-install": "tsx scripts/semantic-model-cli.ts install",
    "semantic:status": "tsx scripts/semantic-cli.ts status",
    "semantic:reindex": "tsx scripts/semantic-cli.ts reindex",
    "semantic:retry-failed": "tsx scripts/semantic-cli.ts retry-failed",
    "semantic:run": "tsx scripts/semantic-cli.ts run",
    "qa:f20-performance": "tsx scripts/f20-performance.ts",
    "assistant:status": "tsx scripts/assistant-cli.ts status",
    "assistant:model:install": "tsx scripts/assistant-cli.ts install",
    "assistant:test": "tsx scripts/assistant-cli.ts test",
    "assistant:bakeoff": "tsx scripts/assistant-cli.ts bakeoff",
    "qa:f21-performance": "tsx scripts/f21-performance.ts",
    "qa:f15": "tsx scripts/f15-qa-fixture.ts create",
    "qa:f15-clean": "tsx scripts/f15-qa-fixture.ts destroy",
    "qa:f16": "tsx scripts/f16-qa-fixture.ts create",
    "qa:f16-clean": "tsx scripts/f16-qa-fixture.ts destroy",
    "test:assistant": "tsx scripts/run-assistant-tests.ts",
    "qa:f21-longdoc": "tsx scripts/run-assistant-tests.ts --longdoc",
    "qa:f21-acceptance": "tsx scripts/run-assistant-tests.ts --acceptance",
    "qa:f21-browser-fixture": "tsx scripts/f21-browser-fixture.ts",
    "qa:f21-contention": "tsx scripts/run-assistant-tests.ts --contention"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.0",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^6.3.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^6.2.10",
    "pino": "^9.6.0",
    "unzipper": "^0.12.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.1",
    "@types/unzipper": "^0.10.11",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "onnxruntime-node@1.24.3": true
  }
}
