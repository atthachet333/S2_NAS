# ============================================================
#  S2 NAS - Backend Environment
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องที่ใช้งาน
#  ห้าม commit ไฟล์ .env เข้า repository
# ============================================================

# development | production | test
NODE_ENV=development

# Backend port (ห้ามซ้ำกับ Frontend 8888)
BACKEND_PORT=8889
BACKEND_HOST=0.0.0.0

# Frontend origin สำหรับ CORS (คั่นด้วย comma ได้)
CORS_ORIGIN=http://localhost:8888

# ------------------------------------------------------------
# Database (MariaDB)
# ------------------------------------------------------------
# รูปแบบ: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/s2_nas_dev"

# ------------------------------------------------------------
# File Storage
# ------------------------------------------------------------
# Production ให้ชี้ไปยัง storage ของเครื่อง Server เช่น D:\S2_NAS_STORAGE
# Development ใช้ ./storage ได้
S2_NAS_STORAGE_ROOT=./storage
S2_NAS_MAX_UPLOAD_BYTES=104857600
S2_NAS_ZIP_MAX_RESOURCES=1000
S2_NAS_ZIP_MAX_BYTES=2147483648
S2_NAS_TRASH_RETENTION_DAYS=14

# การสำรองข้อมูล - รากของชุดสำรองต้องอยู่นอก S2_NAS_STORAGE_ROOT เสมอ
S2_NAS_BACKUP_ROOT=D:/S2_NAS_BACKUPS
# โฟลเดอร์ของ MariaDB client (mariadb-dump / mariadb)
S2_NAS_MARIADB_BIN=C:/MariaDB-Client-12.3/bin
# คำนำหน้าฐานข้อมูลสำหรับ staged restore (ต้องเป็น namespace ที่บัญชีสร้างได้)
S2_NAS_RESTORE_DB_PREFIX=test_s2nas_restore_

# เข้าสู่ระบบด้วย Google - ยืนยันตัวตนเท่านั้น ไม่มีการเข้าถึง Google Drive
# client secret ต้องอยู่ฝั่ง backend เท่านั้น
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8889/api/auth/google/callback
S2_NAS_APP_ORIGIN=http://localhost:8888

# ตารางเวลาสำรองข้อมูล - เวลาตีความตามโซนเวลาด้านล่าง ไม่ใช่ UTC
S2_NAS_BACKUP_ENABLED=true
S2_NAS_BACKUP_TIME=02:00
S2_NAS_BACKUP_TIMEZONE=Asia/Bangkok
S2_NAS_BACKUP_RETENTION_DAYS=30
S2_NAS_BACKUP_MIN_KEEP_COUNT=7

# สำเนานอกเครื่อง - ต้องไม่ซ้อนกับ storage หรือ backup root
S2_NAS_OFFSITE_COPY_ENABLED=false

# การซ้อมกู้คืนอัตโนมัติ - พิสูจน์ว่าชุดสำรองยังกู้คืนได้จริง (ไม่แตะระบบจริง)
S2_NAS_RESTORE_REHEARSAL_ENABLED=true
S2_NAS_RESTORE_REHEARSAL_DAY=0
S2_NAS_RESTORE_REHEARSAL_TIME=03:30
# S2_NAS_OFFSITE_BACKUP_ROOT=E:/S2_NAS_OFFSITE_BACKUPS

# Legacy fallback when S2_NAS_MAX_UPLOAD_BYTES is omitted
MAX_UPLOAD_SIZE_MB=100

# ------------------------------------------------------------
# Authentication (Phase 2)
# ------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# Seed (Phase 2) - ห้าม hardcode รหัสผ่านใน source code
# ------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
