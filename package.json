{
  "name": "s2-nas",
  "version": "0.1.0",
  "private": true,
  "description": "S2 NAS - ระบบจัดเก็บเอกสารและไฟล์บนเซิร์ฟเวอร์",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently --kill-others-on-fail --names \"BACKEND,FRONTEND\" --prefix-colors \"blue.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "test": "npm --prefix backend run test && npm --prefix frontend run test",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "rbac:sync": "npm --prefix backend run rbac:sync",
    "backup:create": "npm --prefix backend run backup:create",
    "backup:list": "npm --prefix backend run backup:list",
    "backup:verify": "npm --prefix backend run backup:verify --",
    "backup:stage-restore": "npm --prefix backend run backup:stage-restore --",
    "backup:schedule-status": "npm --prefix backend run backup:schedule-status",
    "backup:retention": "npm --prefix backend run backup:retention",
    "backup:offsite": "npm --prefix backend run backup:offsite --",
    "backup:lock-status": "npm --prefix backend run backup:lock-status",
    "restore:rehearsal": "npm --prefix backend run restore:rehearsal",
    "restore:rehearsal-status": "npm --prefix backend run restore:rehearsal-status",
    "test:backend": "npm --prefix backend run test",
    "test:frontend": "npm --prefix frontend run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
